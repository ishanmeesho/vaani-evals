# Copy to .env (gitignored) and fill in. Do NOT commit .env, and do not paste
# any of these values into a chat window or a ticket.

# ── Metabase ────────────────────────────────────────────────────────
MB_BASE_URL=https://metabase-main.bi.meeshogcp.in
MB_AUTH_MODE=session_cookie

# Leave blank and pass --cookie inline instead. The session cookie expires with
# your browser session, so persisting it here just means re-editing this file.
# To get it: log into Metabase in Chrome, DevTools -> Application -> Cookies ->
# metabase-main.bi.meeshogcp.in -> copy the metabase.SESSION value.
MB_SESSION_TOKEN=

# Numeric Metabase database id holding the `gold` schema. 9 = "Presto Prod File
# Download" as of 2026-09-08 — verify with toolkit/list_databases.py.
MB_DATABASE_ID=9
MB_TABLE=gold.va_user_session_activity
MB_OUT_DIR=data

# ── Eval harness ────────────────────────────────────────────────────
VAANI_EVAL_TABLE=gold.va_user_session_activity
VAANI_JUDGE_BUDGET=25
VAANI_JUDGE_MODEL=claude-sonnet-5

# ── Langfuse ────────────────────────────────────────────────────────
# Left blank on purpose so a real key is never committed. setup_langfuse.sh
# treats .env as gap-filling only, so anything already exported in your shell
# wins over these and blank entries here are ignored.
# The Meesho instance is internal-only, so pushes must run from the VPN.
LANGFUSE_BASE_URL=http://amp-langfuse-web-admin.prd.meesho.int
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROMPT_PREFIX=vaani-eval
