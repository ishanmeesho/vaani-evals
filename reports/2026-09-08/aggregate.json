  "novel_failures": [
    {
      "proposed_id": "AFFIRMATION_POLARITY",
      "name": "Opens with हाँ and then negates, or affirms something it cannot know",
      "asks": "Does the yes/no particle at the start of the reply agree with the content that follows, and with what Vaani actually knows?",
      "why_not_covered": "FACTUALITY is closest but the facts here are correct — the defect is the affirmation particle contradicting them. Spoken aloud to a low-literacy shopper, 'हाँ' followed by 'नहीं है' reverses the answer she hears.",
      "evidence": "हाँ, इस साड़ी के साथ ready to wear blouse नहीं है",
      "severity": "major"
    },
    {
      "proposed_id": "UNACTIONABLE_ASK",
      "name": "Asks the shopper for information Vaani cannot act on",
      "asks": "Does Vaani request a datum — pincode, photo, link, measurement — that it has no ability to apply to the search, the filters or the answer?",
      "why_not_covered": "ACT_NOT_ASK counts the question; NO_MANUAL_DEFLECTION covers work handed back. Neither captures a question whose answer Vaani could not use even if she gave it, which wastes the turn and teaches her the assistant is not listening.",
      "evidence": "आपका पिनकोड क्या है?",
      "severity": "major"
    },
    {
      "proposed_id": "SELF_CONSISTENCY",
      "name": "Contradicts a fact it stated earlier in the same conversation",
      "asks": "Compare every fact Vaani states against every fact it stated earlier in this conversation. Do any two conflict without the screen having demonstrably changed?",
      "why_not_covered": "FACTUALITY grades each claim against supplied context, so two claims that are each individually plausible both pass — yet 549, 89, 103 and 95 for one fabric cannot all be true. Needs a cross-turn check.",
      "evidence": "दाम 549 रुपये है / इसका दाम 89 रुपये दिख रहा है / दाम 103 रुपये दिख रहा है / Buy at ₹95",
      "severity": "blocker"
    },
    {
      "proposed_id": "FALSE_ACTION_CLAIM",
      "name": "Says it did or is doing something it did not do",
      "asks": "For every claim of action — मैं सर्च कर रही हूँ, दिखा देती हूँ, मैंने सर्च कर दिया है, ढूँढ रही हूँ — did the corresponding action actually fire on that turn?",
      "why_not_covered": "SEARCH_TRIGGER catches the missing search; it does not catch the assertion that the search happened. Cheaply auto-detectable by pairing the claim lexicon against the turn's action_type, and directly corrosive of trust.",
      "evidence": "मैंने सर्च कर दिया है — while simultaneously telling her to type the query herself",
      "severity": "blocker"
